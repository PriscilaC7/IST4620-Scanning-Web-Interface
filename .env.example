# =====================================================
# Scanning AI Tool - Environment Configuration
# =====================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# The ONLY authorized scan target (your lab machine IP or hostname)
APPROVED_TARGET=192.168.1.100

# Anthropic API key for the AI assistant panel
# Get one at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_api_key_here
